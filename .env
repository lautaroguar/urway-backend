# Variables del backend de urway (las lee `dotenv` al arrancar).
#
# Este archivo SÍ se sube al repositorio: no tiene nada secreto y así el proyecto
# corre sin configurar nada (lo pidió la cátedra).

# La base SQLite. La ruta es relativa a la carpeta prisma/ → queda en prisma/dev.db.
DATABASE_URL="file:./dev.db"

# El puerto en el que escucha la API. La app busca el backend en el 3000.
PORT=3000
